<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.ikm.nuva</groupId>
        <artifactId>nuva-data</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <groupId>dev.ikm.data.nuva</groupId>
    <artifactId>nuva-export</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>nuva-export</name>

    <properties>
        <revision>${source.version}+1.0.0-SNAPSHOT</revision>
        <!-- Nothing is published unless the deployExport profile is given explicitly. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <!-- PLACEHOLDER: no build logic yet. Add the plugin configuration below when you implement this stage. -->
    <!-- ============================================================================
         DEVELOPER TODO [export-01]: Package the transformed data for publishing
         ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
         WHAT: Package the data store into the artifacts consumers download (for example a data store zip and an interchange-format zip), attach them to the project, and publish ONLY when the deployExport profile and -DaltDeploymentRepository are given.
         INPUT: The finished data store (dataStoreLocation/dataStore).
         OUTPUT: Attached zip artifacts with classifiers; nothing deployed by default.
         EXAMPLE: data store -> nuva-<version>-<classifier>.zip (made-up classifier).
         DONE WHEN: `mvn install` attaches the zips locally; `mvn deploy` without -PdeployExport deploys nothing; with it, deploys to the given repository only.
         REFERENCE: rxnorm-data/rxnorm-export/pom.xml (profile generateDataLocal, assembly reasoned-sa, tinkar-maven-plugin goal export-tinkar-data).
         ============================================================================ -->

    <profiles>
        <!--
            Same id and activation as the references. In the references this profile holds the packaging of the
            exported artifacts; add it here when implementing export-01. It does NOT enable deployment.
        -->
        <profile>
            <id>generateDataLocal</id>
            <activation>
                <property>
                    <name>altDeploymentRepository</name>
                </property>
            </activation>
        </profile>

        <!-- Explicit opt-in to publish: mvn deploy -PdeployExport -DaltDeploymentRepository=<id>::<url> -->
        <profile>
            <id>deployExport</id>
            <properties>
                <maven.deploy.skip>false</maven.deploy.skip>
            </properties>
        </profile>
    </profiles>
</project>
