<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.ikm.nuva</groupId>
        <artifactId>nuva-data</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nuva-owl-transform</artifactId>
    <packaging>pom</packaging>

    <name>nuva-owl-transform</name>

    <!-- ============================================================================
         DEVELOPER TODO [owl-01]: Confirm or drop the OWL transformation
         ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
         WHAT: Keep this module only if the transformed data contains stated axioms that the reasoner needs
               in OWL form; otherwise remove it (see setup-02). The execution below runs the standard
               transformer over the data store at install. Confirm that is enough, or add configuration.
         INPUT: The data store at ${dataStoreLocation}/${dataStore}, written by nuva-pipeline.
         OUTPUT: The same data store, now containing the OWL representation.
         EXAMPLE: Data store with 3 stated relationships (made-up) -> 3 OWL axioms stored.
         DONE WHEN: Running the module twice on a fixture data store gives the same axiom count, and running it
                    without the data store fails with a clear message.
         REFERENCE: rxnorm-data/rxnorm-owl-transform/pom.xml (tinkar-maven-plugin run-owl-transformer).
         ============================================================================ -->
    <build>
        <plugins>
            <plugin>
                <groupId>dev.ikm.maven.tinkar</groupId>
                <artifactId>tinkar-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>owl-transform</id>
                        <!-- Bound to install (the goal's default is earlier) so that `mvn test` needs no data store. -->
                        <phase>install</phase>
                        <goals>
                            <goal>run-owl-transformer</goal>
                        </goals>
                        <configuration>
                            <dataStore>${dataStoreLocation}/${dataStore}</dataStore>
                            <isolate>false</isolate>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
