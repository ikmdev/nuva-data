<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.ikm.nuva</groupId>
        <artifactId>nuva-data</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nuva-reasoner</artifactId>
    <packaging>pom</packaging>

    <name>nuva-reasoner</name>

    <!-- ============================================================================
         DEVELOPER TODO [reasoner-01]: Choose the reasoner
         ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
         WHAT: Set the reasoner-type property in the parent pom.xml to the reasoner that suits the NUVA
               data (ElkSnomedReasoner is the value rxnorm-data uses; the other services are ElkOwlReasoner
               and HybridReasoner). Remove this module if no classification is required (see setup-02).
         INPUT: The data store after owl-transform (or after nuva-pipeline if owl-transform is dropped).
         OUTPUT: The data store with inferred relationships.
         EXAMPLE: A is-a B, B is-a C (made-up) -> inferred A is-a C.
         DONE WHEN: A fixture data store gains exactly the expected inferred relationships.
         REFERENCE: rxnorm-data/rxnorm-reasoner/pom.xml (run-full-reasoner) and reasoner-type in rxnorm-
                    data/pom.xml.
         ============================================================================ -->
    <build>
        <plugins>
            <plugin>
                <groupId>dev.ikm.maven.tinkar</groupId>
                <artifactId>tinkar-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>run-reasoner</id>
                        <!-- Bound to install (the goal's default is earlier) so that `mvn test` needs no data store. -->
                        <phase>install</phase>
                        <goals>
                            <goal>run-full-reasoner</goal>
                        </goals>
                        <configuration>
                            <dataStore>${dataStoreLocation}/${dataStore}</dataStore>
                            <!-- [reasoner-01] CONFIGURE: reasoner-type in the parent pom.xml -->
                            <reasonerType>${reasoner-type}</reasonerType>
                            <isolate>false</isolate>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
